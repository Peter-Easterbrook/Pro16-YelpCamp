<% layout('layouts/boilerplate')%>

<div class="auth-page mx-auto mt-5">
      <div class="card bg-dark bg-gradient shadow-sm">
        <img
          src="https://res.cloudinary.com/onestep-webdev/image/upload/v1662826298/YelpCamp/oh4ug1cyjmqmndq7r7yx.jpg"
          alt=""
          class="card-img-top"
        />
        <div class="card-body">
          <h5 class="card-title text-light">Login</h5>
          <form action="/login" method="POST" class="validated-form" novalidate>
            <div class="mb-3">
              <label class="form-label text-light" for="username"
                >Username</label
              >
              <input
                class="form-control"
                type="text"
                id="username"
                name="username"
                autofocus
                required
              />
              <div class="valid-feedback text-light">Looks good!</div>
            </div>

            <div class="mb-3">
              <label class="form-label text-light" for="password"
                >Password</label
              >
              <input
                class="form-control"
                type="password"
                id="password"
                name="password"
                required
              />
              <div class="valid-feedback text-light">Looks good!</div>
            </div>
            <button class="btn btn-success w-100 shadow-sm">Login</button>
          </form>
        </div>
      </div>
    </div>
