<% layout('layouts/boilerplate')%>
<div class="row">
  <h1 class="text-center pb-3">New Campground</h1>
  <div class="card p-4 col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2 col-xl-6 offset-xl-3 shadow-sm bg-dark bg-gradient">
    <form
      action="/campgrounds"
      method="POST"
      novalidate
      class="validated-form"
      enctype="multipart/form-data"
    >
      <div class="mb-3">
        <label class="form-label text-light" for="title">Title</label>
        <input
          class="form-control"
          type="text"
          id="title"
          name="campground[title]"
          required
        />
        <div class="valid-feedback text-light">Looks good!</div>
      </div>
      <div class="mb-3">
        <label class="form-label text-light" for="location">Location</label>
        <input
          class="form-control"
          type="text"
          id="location"
          name="campground[location]"
          required
        />
        <div class="valid-feedback text-light">Looks good!</div>
      </div>

      <!-- <div class="mb-3">
                <label class="form-label" for="image">Image Url</label>
                <input class="form-control" type="text" id="image" name="campground[image]" required>
                <div class="valid-feedback">
                    Looks good!
                </div>
            </div> -->
      <div class="mb-3">
        <label class="form-label text-light" for="price"
          >Campground Price</label
        >
        <div class="input-group">
          <span class="input-group-text" id="price-label">$</span>
          <input
            type="text"
            class="form-control"
            id="price"
            placeholder="0.00"
            aria-label="price"
            aria-describedby="price-label"
            name="campground[price]"
            required
          />
        </div>
        <div class="valid-feedback text-light">Looks good!</div>
      </div>

      <div class="mb-3">
        <label class="form-label text-light" for="description"
          >Description</label
        >
        <textarea
          class="form-control"
          type="text"
          id="description"
          name="campground[description]"
          required
        ></textarea>
        <div class="valid-feedback text-light">Looks good!</div>
      </div>
      <div class="mb-3">
        <label class="form-label text-light" for="image">Choose image(s)</label>
        <input
          class="form-control"
          type="file"
          id="image"
          name="image"
          accept="image/jpeg,image/png"
          multiple
        />
      </div>

      <div class="mb-3">
        <button class="btn btn-success float-end shadow-sm">
          Add Campground
        </button>
      </div>
    </form>
  </div>
</div>
